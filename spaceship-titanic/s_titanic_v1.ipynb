   "source": [
    "import os\n",
    "\n",
    "# Safely list files under ./input (single quick pass)\n",
    "print('\\n'.join([\n",
    "    os.path.join(root, f)\n",
    "    for root, _, files in os.walk('./input')\n",
    "    for f in files\n",
    "]))"
   ]
